# Configuration for pipeline.sh — copy it to pipeline.env and edit.
#   cp pipeline.env.example pipeline.env
# Environment variables set before running also work (this file overrides them).
# Hardware variables left empty ("") are chosen for the machine (CPU, RAM, GPU,
# disk); set a value to force it.

# ---------------- Telegram ----------------
# Create a bot: message @BotFather → /newbot → copy the token.
# Chat id: send the bot a message, then open https://api.telegram.org/bot<TOKEN>/getUpdates → "chat":{"id":...}
TG_BOT_TOKEN=""
TG_CHAT_ID=""
TG_NAME=""            # machine name shown in the messages (default: hostname)
TG_EPOCH_EVERY=5      # training progress every N epochs (0 = off)

# ---------------- Engine / architecture ----------------
# PYTHON=".venv/bin/python"   # default: trainer/.venv if present, otherwise python3
MAKE_ARCH="native"    # or x86-64-avx2, x86-64-bmi2, x86-64-avx512, apple-silicon ...
NNUE_ARCH="default"   # default | att | threats | att-threats
LAYERS=1              # 1 | 2 (new layer stacks, README section 7.4)

# ---------------- Data generation (gen_data.py) ----------------
GAMES=50000           # ~40–120 positions per game
VAL_GAMES=1000
NODES=5000
DEPTH=0               # >0: use go depth instead of nodes
GEN_WORKERS=""        # empty = auto: cores - 1, limited by free RAM
ADJUDICATE=3000
GEN_OPTS=""           # extra UCI options, e.g. "Hash=32"
CHANCE_SCALING=""     # e.g. 400 → ChanceScaling for both gen_data and match (after fit_scaling)
SEED_BASE=""          # empty = derived from gen + tag (a different --tag per machine → different seeds)

# ---------------- Prepare (prepare_data.py) ----------------
SHARD_SIZE=""         # empty = auto from free RAM (at most 2000000)
MAX_SCORE=10000
SCORE_SCALE=1.0
PREP_WORKERS=""       # empty = auto from cores and RAM

# ---------------- Training (train.py) ----------------
EPOCHS=40
EPOCH_SIZE=10000000
BATCH_SIZE=""         # empty = trial run on the GPU, largest batch that fits in VRAM (at most BATCH_TARGET)
BATCH_TARGET=16384    # the trainer's default batch; never raised above this value
LR=8.75e-4
GAMMA=0.992
LAMBDA=1.0
SCALING=361           # update from the fit_scaling result
TRAIN_FROM=0          # drop the data of early (low quality) generations: first generation to use
CHECKPOINT_EVERY=""   # empty = auto from free disk (last.pt and the .nnue files are always written)
TRAIN_THREADS=""      # empty = auto (all cores when training on the CPU)
DEVICE=""             # "" = auto, GPU with the most free memory; "cpu" to force the CPU
REQUIRE_GPU=1         # 1 = fail if CUDA is not available
INIT_FROM_CURRENT=1   # gen>=1: --init-net from nets/genN.nnue (0 = train from scratch)
TRAIN_ARGS=""         # extra options, e.g. "--stack-balance 8 --no-factorize"
EXTRA_TRAIN=""        # extra data prefixes, e.g. prepared AB data: "data/train_ab0"

# ---------------- SPRT (match.py) ----------------
MATCH_NODES=20000
MATCH_MOVETIME=0      # >0 (ms): use movetime instead of nodes
MATCH_WORKERS=""      # empty = auto: cores - 1, limited by RAM (2 engines per worker)
SPRT="0 5"            # empty = no SPRT (play up to match.py's default --pairs)
MATCH_EPOCHS="last"   # epochs tried in order; the first one to win H1 is chosen, e.g. "40 38 36"
MATCH_OPTS=""         # UCI options for both A and B, as Name=Value
AUTO_PROMOTE=1        # 1 = copy the winning net to nets/gen(N+1).nnue automatically
