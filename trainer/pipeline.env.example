# Cấu hình cho pipeline.sh — copy thành pipeline.env rồi sửa.
#   cp pipeline.env.example pipeline.env
# Biến môi trường đặt trước khi chạy cũng có hiệu lực (file này ghi đè chúng).

# ---------------- Telegram ----------------
# Tạo bot: nhắn @BotFather → /newbot → lấy token.
# Lấy chat id: nhắn bot 1 câu, rồi mở https://api.telegram.org/bot<TOKEN>/getUpdates → "chat":{"id":...}
TG_BOT_TOKEN=""
TG_CHAT_ID=""
TG_NAME=""            # tên máy hiện trong tin nhắn (mặc định: hostname)
TG_EPOCH_EVERY=5      # báo tiến độ train mỗi N epoch (0 = tắt)

# ---------------- Engine / kiến trúc ----------------
# PYTHON=".venv/bin/python"   # mặc định: trainer/.venv nếu có, không thì python3
MAKE_ARCH="native"    # hoặc x86-64-avx2, x86-64-bmi2, x86-64-avx512, apple-silicon ...
NNUE_ARCH="default"   # default | att | threats | att-threats
LAYERS=1              # 1 | 2 (layer stacks mới, README mục 7.4)

# ---------------- Sinh data (gen_data.py) ----------------
GAMES=50000           # ~40–120 vị trí/ván
VAL_GAMES=1000
NODES=5000
DEPTH=0               # >0 thì dùng go depth thay cho nodes
GEN_WORKERS=""        # mặc định: số core - 1
ADJUDICATE=3000
GEN_OPTS=""           # UCI option thêm, vd: "Hash=32"
CHANCE_SCALING=""     # vd 400 → ChanceScaling cho cả gen_data và match (sau khi fit_scaling)
SEED_BASE=""          # để trống = tự tính theo gen + tag (mỗi máy khác --tag → seed khác)

# ---------------- Prepare (prepare_data.py) ----------------
SHARD_SIZE=2000000    # thiếu RAM thì giảm (vd 500000)
MAX_SCORE=10000
SCORE_SCALE=1.0
PREP_WORKERS=""       # mặc định: mọi core

# ---------------- Train (train.py) ----------------
EPOCHS=40
EPOCH_SIZE=10000000
BATCH_SIZE=16384      # thiếu VRAM thì giảm (8192)
LR=8.75e-4
GAMMA=0.992
LAMBDA=1.0
SCALING=361           # cập nhật theo kết quả fit_scaling
TRAIN_FROM=0          # bỏ data các gen đầu (chất lượng thấp): đặt = số gen bắt đầu dùng
CHECKPOINT_EVERY=1    # lưu epoch_K.pt mỗi K epoch (last.pt và .nnue luôn được lưu)
DEVICE=""             # "" = tự chọn cuda; "cpu" để ép CPU
REQUIRE_GPU=1         # 1 = báo lỗi nếu không có CUDA
INIT_FROM_CURRENT=1   # gen>=1: --init-net từ nets/genN.nnue (0 = train từ đầu)
TRAIN_ARGS=""         # cờ thêm, vd: "--stack-balance 8 --no-factorize"
EXTRA_TRAIN=""        # prefix data thêm, vd data AB đã prepare: "data/train_ab0"

# ---------------- SPRT (match.py) ----------------
MATCH_NODES=20000
MATCH_MOVETIME=0      # >0 (ms) thì dùng movetime thay cho nodes
MATCH_WORKERS=""      # mặc định: số core - 1
SPRT="0 5"            # để trống = không SPRT (chơi tới --pairs mặc định)
MATCH_EPOCHS="last"   # các epoch thử lần lượt, epoch đầu tiên thắng H1 được chọn, vd: "40 38 36"
MATCH_OPTS=""         # UCI option cho cả A và B, dạng Name=Value
AUTO_PROMOTE=1        # 1 = tự copy net thắng thành nets/gen(N+1).nnue
