# Configuration for pipeline.sh — copy it to pipeline.env and edit.
#   cp scripts/pipeline.env.example scripts/pipeline.env    (from trainer/)
# Environment variables set before running also work (this file overrides them).
# Hardware variables left empty ("") are chosen for the machine (CPU, RAM, GPU,
# disk); set a value to force it.

# ---------------- Telegram ----------------
# Create a bot: message @BotFather → /newbot → copy the token.
# Chat id: send the bot a message, then open https://api.telegram.org/bot<TOKEN>/getUpdates → "chat":{"id":...}
TG_BOT_TOKEN=""
TG_CHAT_ID=""
TG_NAME=""            # machine name shown in the messages (default: hostname)
TG_EPOCH_EVERY=5      # training progress every N epochs (0 = off)

# ---------------- Engine / architecture ----------------
# PYTHON=".venv/bin/python"   # default: trainer/.venv if present, otherwise python3
MAKE_ARCH="native"    # or x86-64-avx2, x86-64-bmi2, x86-64-avx512, apple-silicon ...
                      # (x86-64-universal: one binary for every x86-64 machine, ~8x build time)
NNUE_ARCH="default"   # default | att | threats | att-threats
LAYERS=1              # 1 | 2 (new layer stacks, README section 7.4)
META=0                # 1 = meta features (README 7.8; new prepared data)
BLEND=0               # 1 = blended layer stack selection (README 7.7; new prepared data)
CTX=0                 # 1 = inventory context (README 7.6)
PSQT=1                # 0 = network without PSQT (README 7.5; needs INIT_NET or a first trained net)
QUANT=1               # 2 = alternative quantization (README 7.12; make quant=2, nets *-q2)
STACKS=16             # 32 = 32 layer stacks (README 7.14; make stacks=32, nets *-s32; new prepared
                      # data; not with BLEND=1; INIT_NET of 16 stacks: same evaluation)
EVAL_SCALING="Complexity"  # or "Alignment": the engine's EvalScaling option (README 7.13), for
                      # generating, training, checking and matching; suits PSQT=0
INIT_NET=""           # generation 0 of a new architecture: this net converted (README 7.9),
                      # e.g. "nets/gen5.nnue" with META=1 / CTX=1 (same evaluation)

# ---------------- reference engine (gen0 games, scores, reference opponent) ----------------
# Default layout: ../jieqi/ref-engine and the newest ../jieqi/ref-engine*.nnue
#JIEQI_DIR="$HOME/maskfish/jieqi"
#REF_ENGINE="$JIEQI_DIR/ref-engine"
#REF_NET="$JIEQI_DIR/ref-engine.nnue"
REF_OPTS="ChasingRule=github"
REF_GEN_NODES=10000    # nodes per move when the reference engine plays the games (--source ref)
REF_LABEL_NODES=20000  # nodes per position when the reference engine scores Maskfish games (--source distill)
REF_HASH=16
REF_ADJUDICATE=1500    # adjudication of reference engine games, in its units (~half of Maskfish units)
SOURCE=""             # ref | distill | self ; empty = ref for -g 0, distill otherwise

# ---------------- Data generation (gen_data.py) ----------------
GAMES=50000           # ~40–120 positions per game
VAL_GAMES=1000
NODES=5000
DEPTH=0               # >0: use go depth instead of nodes
GEN_WORKERS=""        # empty = auto: cores - 1, limited by free RAM
ADJUDICATE=3000
GEN_OPTS=""           # extra UCI options, e.g. "Hash=32"
CHANCE_SCALING=""     # e.g. 400 → ChanceScaling for both gen_data and match (after fit_scaling)
SEED_BASE=""          # empty = derived from gen + tag (a different --tag per machine → different seeds)

# ---------------- Prepare (prepare_data.py) ----------------
SHARD_SIZE=""         # empty = auto from free RAM (at most 2000000)
MAX_SCORE=10000
SCORE_SCALE=1.0
PREP_WORKERS=""       # empty = auto from cores and RAM
PREP_MIRROR=0         # 1 = also the positions mirrored left-right (README 7.15; prepares again)
PREP_MAX_DUPS=0       # N > 0 = at most N copies of each position (README 7.15; prepares again)

# ---------------- Training (train.py) ----------------
EPOCHS=40
EPOCH_SIZE=10000000
BATCH_SIZE=""         # empty = trial run on the GPU, largest batch that fits in VRAM (at most BATCH_TARGET)
BATCH_TARGET=16384    # the trainer's default batch; never raised above this value
LR=8.75e-4
GAMMA=0.992
LAMBDA=1.0
SCALING=361           # update from the fit_scaling result
TRAIN_FROM=0          # drop the data of early (low quality) generations: first generation to use
CHECKPOINT_EVERY=""   # empty = auto from free disk (last.pt and the .nnue files are always written)
TRAIN_THREADS=""      # empty = auto (all cores when training on the CPU)
DEVICE=""             # "" = auto, GPU with the most free memory; "cpu" to force the CPU
TRAIN_GPUS=1          # >1: train on that many GPUs at once (torchrun + DDP); BATCH_SIZE is then the total batch
QAT_START=0           # >0: quantization-aware training from this epoch on (e.g. EPOCHS-4 for the last 5 epochs)
REQUIRE_GPU=1         # 1 = fail if CUDA is not available
INIT_FROM_CURRENT=1   # gen>=1: --init-net from nets/genN.nnue (0 = train from scratch)
TRAIN_ARGS=""         # extra options, e.g. "--stack-balance 8 --no-factorize" or "--tensorboard"
EXTRA_TRAIN=""        # extra data prefixes, e.g. prepared reference data: "data/train_ref0"

# ---------------- SPRT (match.py) ----------------
MATCH_NODES=20000
MATCH_MOVETIME=0      # >0 (ms): use movetime instead of nodes
MATCH_WORKERS=""      # empty = auto: cores - 1, limited by RAM (2 engines per worker)
SPRT="0 5"            # empty = no SPRT (play up to MATCH_MAX_PAIRS)
MATCH_MAX_PAIRS=6000  # no SPRT decision after this: promoted only if Elo − 95% error > 0
MATCH_EPOCHS="last"   # epochs tried in order; the first one to win H1 is chosen, e.g. "40 38 36"
MATCH_OPTS=""         # UCI options for both A and B, as Name=Value
AUTO_PROMOTE=1        # 1 = copy the winning net to nets/gen(N+1).nnue automatically
FTPERM=0              # 1 = reorder the promoted net's neurons for engine speed (ftperm.py, same evaluations)
