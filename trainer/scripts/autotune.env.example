# Configuration of autotune.sh — copy to scripts/autotune.env (or run
#   scripts/autotune.sh --init-config) and edit.
# Telegram, hardware, games / nodes / epochs, reference engine paths come from
# scripts/pipeline.env (shared with pipeline.sh). Values here override them.

# ---------------- reference engine ----------------
# Defaults: ../jieqi/ref-engine and the newest ../jieqi/ref-engine*.nnue
#JIEQI_DIR="$HOME/maskfish/jieqi"
#REF_ENGINE="$JIEQI_DIR/ref-engine"
#REF_NET="$JIEQI_DIR/ref-engine.nnue"
REF_OPTS="ChasingRule=github"   # chasing rules closest to Maskfish's

# ---------------- stage 1 · ref: gen0 from reference engine games ----------------
GEN0_GAMES=50000      # reference engine self-play games (REF_GEN_NODES nodes per move, pipeline.env)
GEN0_EPOCHS=40

# ---------------- stage 2 · distill: Maskfish plays, the reference engine scores ----------------
DISTILL_NODES=5000    # Maskfish nodes per move (REF_LABEL_NODES for the reference engine's score, pipeline.env)
NEAR_REF_ELO=-30       # go to stage self once a new net is within this of the reference engine
DISTILL_PATIENCE=3    # … or after this many failed attempts in a row

# ---------------- stage 3 · self: Maskfish plays and scores ----------------
SELF_NODES=10000
PATIENCE=3            # failed attempts in a row before scaling up (level +1)
LEVEL_CAP=4           # level L: games × (1 + L/2), nodes × (1 + L/4); stop after LEVEL_CAP
TRAIN_WINDOW=4        # train on the data of the last N generations (0 = all)
MAX_HOURS=0           # 0 = until the Elo stops rising

# ---------------- measuring against the reference engine ----------------
EXT_MOVETIME=200      # ms per move for both engines (node counts of different engines differ)
EXT_PAIRS=400         # game pairs per new net: about ±25 Elo (95%)

# ---------------- stage 4 · engine options ----------------
OPT_START_ELO=-30     # first option cycle once a net reaches this Elo vs the reference engine (or stage self)
OPT_EVERY=3           # then a new cycle every N new nets
OPT_NODES=20000
OPT_SPRT="0 3"        # Jieqi games are very noisy (few draws): with [0,3] a +3 Elo option needs
OPT_MAX_PAIRS=12000   # ~10000 pairs; no decision at the maximum = the option is LEFT AS IT IS
OPT_RETRY=2           # and tested again in up to OPT_RETRY later cycles (with a stronger net)
OPT_GROUP=1           # the undecided options that leaned positive are also tested together
# not tested: output only, several threads only (SharedHistory, SimpleThreadVote), time
# management only (StopEarly, SimpleMtg: no effect with a node limit), speed only (ThreatCache,
# ThreatsIncremental: same search, compare with bench), data format (JieqiMaterial), SeekMate
OPT_EXCLUDE="Ponder UCI_ShowWDL RawScore SharedHistory StopEarly JieqiMaterial SeekMate SimpleThreadVote SimpleMtg ThreatCache ThreatsIncremental VoteSinglePVOnly FrequentTimeCheck"
NO_DATA_OPTS="RevealQuiet RevealQsearchEvasions EvalScaling"   # accepted options never used to generate data (prefixes)
OPT_INT_TESTS="ChanceRiskAversion:10,20,-10"
OPT_INT_REMOVABLE=""
OPT_GROUP_TESTS="EvalCorrelation:EvalScaling=Correlation ChanceLinear:ChanceModel=Linear+ChanceRiskAversion=3"
                      # e.g. also "RevealQuietOff:RevealQuietBase=0+RevealQuietSafety=0+RevealQuietHighValue=0"
#OPT_ONLY="MultiCutHistory ContCorr4Ply"   # only test these options
BENCH_ARGS="16 1 13"  # bench used to verify every patch (must give exactly the same node count)
RETRY_MAX=5
