# Configuration of autotune.sh — copy to scripts/autotune.env (or run
#   scripts/autotune.sh --init-config) and edit.
# Telegram, hardware, games / nodes / epochs, reference engine paths come from
# scripts/pipeline.env (shared with pipeline.sh). Values here override them.

# ---------------- reference engine ----------------
# How it is used (one switch for the whole loop; scripts/README.md 4.2):
#   teach    stages ref → distill → self: it plays gen0, scores the distill data, measures every net
#   measure  Maskfish plays and scores its own games from the start; it only measures every new net
#   off      not used at all (no REF_ENGINE needed): self-play only, no Elo against it
# Switching an ongoing run away from teach moves it to stage self at the next start.
REF_MODE=teach
# Which engine it is is only configuration (scripts/README.md 4.9); usually set in pipeline.env.
# Defaults: ../jieqi/ref-engine and the newest ../jieqi/ref-engine*.nnue
#JIEQI_DIR="$HOME/maskfish/jieqi"
#REF_ENGINE="$JIEQI_DIR/ref-engine"
#REF_NET="$JIEQI_DIR/ref-engine.nnue"   # sent as EvalFile; empty: none (network built in, or in REF_OPTS)
#REF_OPTS=""           # its UCI options, e.g. its repetition / chasing rules closest to Maskfish's
#REF_NAME=ref-engine   # default: file name of REF_ENGINE; names data/REF_NAME.scale and the Elo results
#EXT_REFEREE=          # Maskfish judging reference matches (default: ENGINE; empty: the reference engine)

# ---------------- stage 1 · ref: gen0 from reference engine games ----------------
GEN0_GAMES=50000      # reference engine self-play games (REF_GEN_NODES nodes per move, pipeline.env)
GEN0_EPOCHS=40

# ---------------- stage 2 · distill: Maskfish plays, the reference engine scores ----------------
DISTILL_NODES=5000    # Maskfish nodes per move (REF_LABEL_NODES for the reference engine's score, pipeline.env)
NEAR_REF_ELO=-30       # go to stage self once a new net is within this of the reference engine
DISTILL_PATIENCE=3    # failed attempts in a row before scaling up (level +1) …
DISTILL_LEVEL_CAP=2   # … and at this level, before going to stage self

# ---------------- stage 3 · self: Maskfish plays and scores ----------------
SELF_NODES=10000
PATIENCE=3            # failed attempts in a row before scaling up (level +1)
LEVEL_CAP=4           # level L: games × (1 + L/2), nodes × (1 + L/4); stop after LEVEL_CAP
TRAIN_WINDOW=4        # train on the data of the last N generations (0 = all)
MAX_HOURS=0           # 0 = until the Elo stops rising

# ---------------- measuring against the reference engine ----------------
EXT_MOVETIME=200      # ms per move for both engines (node counts of different engines differ)
EXT_PAIRS=400         # game pairs per new net: about ±25 Elo (95%)
#EXT_GO="depth 12"    # instead of EXT_MOVETIME: any limit as "go" arguments (an engine without movetime)
EXT_VETO=1            # stage distill: take back a new net clearly weaker against the reference engine
#MATCH_EARLIER="4 8"  # also SPRT epochs EPOCHS-4, EPOCHS-8 when the last one loses (default: last only)

# ---------------- stage 4 · engine options ----------------
OPT_START_ELO=-30     # first option cycle once a net reaches this Elo vs the reference engine (or stage self)
OPT_START_GEN=1       # … and not before net genN (e.g. 6 for REF_MODE=off / measure from zero)
OPT_EVERY=3           # then a new cycle every N new nets
OPT_NODES=20000
OPT_SPRT="0 3"        # Jieqi games are very noisy (few draws): with [0,3] a +3 Elo option needs
OPT_MAX_PAIRS=12000   # ~10000 pairs; no decision at the maximum = the option is LEFT AS IT IS
OPT_RETRY=2           # and tested again in up to OPT_RETRY later cycles (with a stronger net)
OPT_GROUP=1           # the undecided options that leaned positive are also tested together
# not tested: output only, several threads only (SharedHistory, SimpleThreadVote, NMPOddThreads),
# time management only (StopEarly, SimpleMtg, TMEffortFactor, TMReductionInterp: no effect with a
# node limit), speed only (ThreatCache, ThreatsIncremental: same search, compare with bench), data
# format (JieqiMaterial), network format (MidMirror*: needs a net trained with it), SeekMate*,
# and the chance node options (tested on the clock by OPT_TC_TESTS). Write the whole list: this
# file is read before the defaults of autotune.sh, so "$OPT_EXCLUDE ..." would drop them.
# (OptimismMerged is added automatically unless EVAL_SCALING is Alignment / Correlation.)
OPT_EXCLUDE="Ponder UCI_ShowWDL RawScore SharedHistory StopEarly JieqiMaterial SeekMate SimpleThreadVote SimpleMtg ThreatCache ThreatsIncremental VoteSinglePVOnly FrequentTimeCheck TMEffortFactor TMReductionInterp NMPOddThreads SeekMatePrevScore MidMirrorPawnTieBreak MidMirrorNoKingFlag ChanceExpandMain ChanceMixTT ChanceMixFut ChanceRevealCheckQs SMPSkip ChanceQsearchRep CheckExtension ChanceChildWindow ChanceTTProbe"
NO_DATA_OPTS="RevealQuiet RevealQsearchEvasions EvalScaling"   # accepted options never used to generate data (prefixes)
OPT_INT_TESTS="ChanceRiskAversion:10,20,-10"
OPT_INT_REMOVABLE=""
OPT_GROUP_TESTS="EvalCorrelation:EvalScaling=Correlation ChanceLinear:ChanceModel=Linear+ChanceRiskAversion=3"
                      # e.g. also "RevealQuietOff:RevealQuietBase=0+RevealQuietSafety=0+RevealQuietHighValue=0"
#OPT_ONLY="MultiCutHistory ContCorr4Ply"   # only test these options
# chance node options on the clock (STC, then LTC on a win), in order; see scripts/README.md 4.4
#OPT_TC_TESTS="cap:ChanceMaxLayers=1+ChanceCV=3 mix:ChanceMix=6+ChanceQsearchRep=true+ChanceMixTT=true+ChanceMixFut=true:alt=cap capcheck:ChanceRevealCheck=2:need=ChanceMaxLayers:sprt=0,3 ..."
OPT_TC=10+0.1         # STC
OPT_LTC=40+0.4        # LTC after an STC win (empty: the STC decides)
OPT_TC_SPRT="0 5"     # default bounds (sprt=0,3 per test for the small changes)
OPT_TC_MAX_PAIRS=6000
#OPT_TC_WORKERS=3     # default: physical cores − 1
BENCH_ARGS="16 1 13"  # bench used to verify every patch (must give exactly the same node count)
RETRY_MAX=5
