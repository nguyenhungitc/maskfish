# Option plan of autotune.sh: which engine options the option cycles test, and how
# (scripts/README.md 4.4). Copy to scripts/option-plan.env (or set OPT_PLAN in autotune.env)
# and edit. Without a plan, no option cycle runs.
#
# The tests are temporary: once an entry is decided (see autotune.sh --status and
# autotune/decisions.tsv), delete it here. A decided entry is not run again anyway, and
# autotune reports every name of this file that is no option of the engine any more.
# Every name below is an engine option of src/engine.cpp at the time of writing.

# ---------------- never tested at fixed nodes ----------------
# Boolean options are tested one by one at fixed nodes unless they are listed here (the
# options of OPT_TC_TESTS are left out automatically): output / protocol only, data or
# network format (a network trained with the same setting is needed), speed only (same
# search: compare with bench), no aim at playing strength, no effect alone, and options
# that only change something with time management or several threads.
OPT_EXCLUDE="Ponder UCI_ShowWDL RawScore
  JieqiMaterial MidMirrorPawnTieBreak MidMirrorNoKingFlag
  ThreatCache ThreatsIncremental
  SeekMate SeekMatePrevScore
  ChanceExpandMain ChanceRevealCheckQs
  VoteSinglePVOnly FrequentTimeCheck
  OptimismMerged"
# (OptimismMerged: only with EVAL_SCALING Alignment / Correlation)

# accepted options (name prefixes) never used to generate data: a search preference, or an
# evaluation the trainer does not model (the data is made with EVAL_SCALING of pipeline.env)
NO_DATA_OPTS="RevealQuiet EvalScaling"

# ---------------- numeric values and groups, at fixed nodes ----------------
OPT_INT_TESTS=""          # Name:value,value
OPT_INT_REMOVABLE=""      # numeric options that may be removed after H0
OPT_GROUP_TESTS="EvalCorrelation:EvalScaling=Correlation"   # id:Opt=V+Opt=V (applied by hand)

# ---------------- tests on the clock (STC, then LTC on a win) ----------------
# For options a fixed-node match misjudges (the node count misses the work of the reveal
# outcomes), or that need time management or several threads. In order; one entry each:
#   id:Opt=V+Opt=V[:need=[!]Name,...][:alt=id][:sprt=E0,E1][:both=Opt=V+Opt=V][:workers=N]
OPT_TC_TESTS="
  cap:ChanceMaxLayers=1+ChanceCV=3
  mix:ChanceMix=6+ChanceQsearchRep=true+ChanceMixTT=true+ChanceMixFut=true:alt=cap
  capcheck:ChanceRevealCheck=2:need=ChanceMaxLayers:sprt=0,3
  caplate:ChanceLateDark=12:need=ChanceMaxLayers:sprt=0,3
  capqsrep:ChanceQsearchRep=true:need=ChanceMaxLayers:sprt=0,3
  mixlow:ChanceMixLow=15:need=ChanceMix:sprt=0,3
  qsdark:QsearchDarkPly=4:sprt=0,3
  checkext:CheckExtension=true:sprt=0,3
  childwindow:ChanceChildWindow=true:sprt=0,3
  ttprobe:ChanceTTProbe=true:sprt=0,3
  childttprobe:ChanceChildWindow=true+ChanceTTProbe=true:need=!ChanceChildWindow,!ChanceTTProbe:sprt=0,3
  smpskip:SMPSkip=true:both=Threads=4:sprt=0,3
  nmpodd:NMPOddThreads=true:both=Threads=4:sprt=0,3
  threadvote:SimpleThreadVote=true:both=Threads=4:sprt=0,3
  sharedhist:SharedHistory=true:both=Threads=4:sprt=0,3
  tmeffort:TMEffortFactor=true:sprt=0,3
  tminterp:TMReductionInterp=true:sprt=0,3
  stopearly:StopEarly=true:sprt=0,3
  simplemtg:SimpleMtg=true:sprt=0,3
"
