# Configuration of scripts/pipeline.sh (and of scripts/autotune.sh, which reads it first).
# Copy to scripts/pipeline.env (or run scripts/autotune.sh --init-config) and edit.
# Every value has a default in pipeline.sh; an empty value means "automatic".
# The file is sourced by bash: VAR=value, no spaces around "=".

# ---------------- Telegram (optional) ----------------
TG_BOT_TOKEN=""          # from @BotFather
TG_CHAT_ID=""            # from https://api.telegram.org/bot<TOKEN>/getUpdates after a message to the bot
TG_EPOCH_EVERY=5         # a training report every N epochs
#TG_NAME=my-gpu-box      # prefix of every message (default: the host name)

# ---------------- build and net ----------------
#PYTHON=.venv/bin/python # default: .venv/bin/python if it exists, else python3 (needs numpy; torch + CUDA to train)
BUILD_ARCH=native        # native | portable | a -march value (x86-64-v3, ...): build/pipeline/maskfish
BUILD_OPTS=""            # more CMake options, e.g. "-DMASKFISH_LTO=ON"
#INIT_NET=nets/maskfish.nnue   # gen0, the net training starts from (default: nets/maskfish.nnue, from refs/assets/net)

# ---------------- reference engine (--source ref | distill, autotune measurements) ----------------
# Any UCI Jieqi engine that reads the position as Maskfish writes it (tools/match.py).
#JIEQI_DIR="$HOME/maskfish/jieqi"
#REF_ENGINE="$JIEQI_DIR/ref-engine"
#REF_NET="$JIEQI_DIR/ref-engine.nnue"   # sent as EvalFile; empty: none
#REF_OPTS=""             # its UCI options, as Name=Value,Name=Value
#REF_NAME=ref-engine     # default: the file name of REF_ENGINE; names data/REF_NAME.scale
REF_GEN_NODES=10000      # nodes per move when it plays the games (--source ref)
REF_GEN_DEPTH=0          # >0: a depth instead
REF_LABEL_GO="nodes 20000"   # its search of every scored position (--source distill), as "go" arguments
REF_HASH=16
ENGINE_TIMEOUT=600       # seconds for one search before the engine is considered hung
MASKFISH_K=""            # Maskfish's score scale; empty = fitted once on its own data (data/maskfish.scale)

# ---------------- data ----------------
GAMES=20000              # training games per generation
VAL_GAMES=500            # validation games
NODES=5000               # nodes per move (self-play, and the playing side of distill)
DEPTH=0                  # >0: a depth limit as well
RANDOM_PLIES=8           # random opening plies (0..N) of every game
GEN_HASH=16
GEN_OPTS=""              # UCI options of the generating engine, as Name=Value,Name=Value
GEN_THREADS=""           # empty = cores - 1
LABEL_WORKERS=""         # empty = cores - 1
SEED_BASE=""             # empty = from the generation and the tag

# ---------------- training ----------------
EPOCHS=10
LR=""                    # empty = the trainer's default (5e-4)
LAMBDA=0.7               # weight of the score (1 - LAMBDA: the game result)
BATCH_SIZE=""            # empty = from the GPU memory (scripts/hw_probe.py)
TRAIN_FROM=0             # first generation whose data is used
TRAIN_WINDOW=0           # >0: only the data of the last N generations
EXTRA_TRAIN=""           # more record files, e.g. "data/old.bin"
INIT_FROM_CURRENT=1      # start from the current net (runs/genN/best.pt, else nets/genN.nnue itself)
STREAM=""                # records in memory at a time; empty = from the free RAM
REQUIRE_GPU=1            # 1 = fail without CUDA; 0 = train on the CPU when there is no CUDA (slowly)
TRAIN_ARGS=""            # more train/train.py options, e.g. "--qat-from 0.5"
TRAINER=""               # another trainer script with the same options

# ---------------- SPRT new net vs current net ----------------
MATCH_NODES=20000        # nodes per move …
MATCH_MOVETIME=0         # … or ms per move (>0) …
MATCH_TC=""              # … or a clock, e.g. "10+0.1"
MATCH_WORKERS=""         # empty = cores - 1, limited by RAM
MATCH_HASH=16
SPRT="0 5"               # elo0 elo1; empty = MATCH_MAX_PAIRS pairs, promoted if Elo - 95% error > 0
SPRT_MODEL=logistic      # logistic | normalized
MATCH_MAX_PAIRS=4000
MATCH_EPOCHS="best last" # candidates, in order; the first that wins is promoted
MATCH_OPTS=""            # UCI options of both engines
AUTO_PROMOTE=1           # 0 = only report the winner
