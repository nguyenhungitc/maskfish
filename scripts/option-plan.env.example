# Option plan of scripts/autotune.sh: which UCI options the option cycles test.
# Copy to scripts/option-plan.env (or set OPT_PLAN in autotune.env) and edit.
# Without a plan (or with both lists empty) no option cycle runs.
#
# Every entry is "id|VALUES": VALUES are one or more settings separated by spaces, each
# Name=Value or several joined with "+" (Name=Value+Name=Value). The settings are tried in
# order against the options in use; the first one that wins its SPRT (H1) is taken:
#   H1           in use: set in every later generation and match (GEN_OPTS / MATCH_OPTS),
#                listed in autotune/REPORT.md — make it the default in src/ by hand
#   H0 (all)     rejected, not tested again
#   no decision  left as it is, tested again in up to OPT_RETRY later cycles
# A decided entry is not run again; delete it here once you have read the decision
# (scripts/autotune.sh --status, autotune/decisions.tsv). An entry naming an option the
# engine does not have (printf 'uci\n' | build/pipeline/maskfish) is skipped with a note.
#
# The entries below are the options that are off by default in src/search.cpp, each with values
# that change the search of `bench 12` (a value that leaves the node count unchanged tests
# nothing). Not listed: ChanceRed, ChanceRedLow, ChanceCV*, RepMode=2, ChancePvW and
# ChanceMixRho0, which act only with ChanceMix 0 or ChanceXDepth 0; SmpVote and SmpDefer
# (Threads > 1); NodesTime (a testing aid). Check them against the engine before a long run.

# ---------------- at fixed nodes (OPT_NODES, OPT_SPRT) ----------------
OPT_TESTS=(
  "corrhist|CorrHist=100 CorrHist=200"
  "singular|SeDepth=8 SeDepth=6+SeMargin=24"
  "probcut|ProbCut=150 ProbCut=250"
  "razor|RazorDepth=3"
  "histprune|HistPrune=500"
  "qsttmove|QsTTMove=1"
  "caplmr|CapLmr=1 CapLmr=2"
  "seequietorder|SeeQuietOrder=100"
  "revealcheck|RevealCheck=2 RevealCheck=2+RevealCheckQs=1"
  "repmode|RepMode=1"
  "chancetailfix|ChanceTailFix=2 ChanceTailFix=1"
  "chancemixskip|ChanceMixSkip=1"
  "chancemixdiv|ChanceMixDiv=4"
  "chancemixpvr|ChanceMixPvR=4+ChanceMixPvPly=1 ChanceMixPvR=3"
  "chancelatedark|ChanceLateDark=6"
  "chancemixlow|ChanceMixLow=10 ChanceMixLow=10+ChanceMixLowR=99"
  "threatrevroot|ThreatRevRoot=50"
  "threatrevscale|ThreatRevScale=50"
  "threatrevlmr|ThreatRevLmr=50"
  "threatrevorder|ThreatRevOrder=4000 ThreatRevMode=1+ThreatRevOrder=4000"
  "rootdarkpen|RootDarkPen=20 RootDarkPen=-20"
)

# ---------------- on the clock (OPT_TC, then OPT_LTC after a win; OPT_TC_SPRT) ----------------
# For time management, and for options a fixed-node match misjudges.
OPT_TC_TESTS=(
  "tmfall|TmFall=100"
  "tmmtg|TmMtgMin=10+TmMtgDec=2"
  "chancemixrho|ChanceMixRho=50"     # these two search many more nodes per depth
  "chancemixpv|ChanceMixPv=1"
)
