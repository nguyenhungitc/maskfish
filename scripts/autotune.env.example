# Configuration of scripts/autotune.sh — copy to scripts/autotune.env (or run
#   scripts/autotune.sh --init-config) and edit.
# Telegram, hardware, games / nodes / epochs and the reference engine come from
# scripts/pipeline.env (shared with pipeline.sh). Values here override them, also in the
# pipeline.sh calls of autotune (e.g. SPRT, MATCH_NODES); GAMES, NODES, EPOCHS, LR, LAMBDA,
# TRAIN_FROM, GEN_OPTS and MATCH_OPTS of those calls are set by autotune itself (level, attempt,
# options in use).

# ---------------- reference engine ----------------
#   teach    stages ref → distill → self: it plays gen0, scores the distill data, measures every net
#   measure  Maskfish plays and scores its own games from the start; it only measures every new net
#   off      not used at all (no REF_ENGINE needed): self-play only, no Elo against it
# Switching an ongoing run away from teach moves it to stage self at the next start.
REF_MODE=teach
# Its paths are usually set in pipeline.env (REF_ENGINE, REF_NET, REF_OPTS, REF_NAME).

# ---------------- stage 1 · ref: gen0 data from reference engine games ----------------
GEN0_GAMES=50000         # its self-play games (REF_GEN_NODES per move, pipeline.env)
GEN0_EPOCHS=40

# ---------------- stage 2 · distill: Maskfish plays, the reference engine scores ----------------
DISTILL_NODES=5000       # Maskfish nodes per move (REF_LABEL_GO for the scores, pipeline.env)
NEAR_REF_ELO=-30         # stage self once a new net is within this of the reference engine
DISTILL_PATIENCE=3       # failed attempts in a row before scaling up (level +1) …
DISTILL_LEVEL_CAP=2      # … and at this level, before stage self

# ---------------- stage 3 · self: Maskfish plays and scores ----------------
SELF_NODES=10000
PATIENCE=3               # failed attempts in a row before scaling up (level +1)
LEVEL_CAP=4              # level L: games × (1 + L/2), nodes × (1 + L/4); finished after LEVEL_CAP
TRAIN_WINDOW=4           # train on the data of the last N generations (0 = all)
TRAIN_MIN_GEN=0          # never train on generations before this one
MAX_HOURS=0              # 0 = until the Elo stops rising
RETRY_MAX=5              # pipeline.sh errors in a row before stopping

# ---------------- measuring against the reference engine ----------------
EXT_LIMIT="--movetime 200"   # match.py limit for both engines: --movetime MS | --nodes N | --depth D | --tc B+I
EXT_PAIRS=400            # game pairs per new net: about ±25 Elo (95%)
EXT_HASH=64
EXT_VETO=1               # stage distill: take back a new net clearly weaker against the reference engine
#MATCH_EARLIER="best last"   # candidates of every SPRT (default: best, then last)

# ---------------- stage 4 · engine options ----------------
# What is tested is in the option plan, scripts/option-plan.env (from option-plan.env.example).
#OPT_PLAN="$HOME/maskfish/scripts/option-plan.env"
OPT_START_ELO=-30        # first option cycle once a net reaches this vs the reference engine (or stage self)
OPT_START_GEN=1          # … and not before genN
OPT_EVERY=3              # then a cycle every N new nets
OPT_NODES=20000          # fixed-node tests
OPT_SPRT="0 3"           # nElo bounds (OPT_SPRT_MODEL=normalized, the default; or logistic):
OPT_SPRT_MODEL=normalized   # Jieqi games are noisy: a +3 option needs ~10000 pairs
OPT_MAX_PAIRS=12000      # no decision at the maximum = the option is LEFT AS IT IS …
OPT_RETRY=2              # … and tested again in up to OPT_RETRY later cycles
OPT_GROUP=1              # the undecided options that leaned positive are also tested together
OPT_TC=10+0.1            # tests on the clock: short …
OPT_LTC=40+0.4           # … then long, after a short win (empty: short only)
OPT_TC_SPRT="0 5"
OPT_TC_MAX_PAIRS=6000
